# Signs player tokens and result records. Set a long random string in production.
RIVALRY_SECRET=
# Devnet RPC (default https://api.devnet.solana.com)
SOLANA_RPC_URL=
# Escrow wallet secret key (base58 or JSON byte array) that holds and pays out prizes.
# Leave empty to disable SOL prizes. Fund it on devnet: solana airdrop 2 <pubkey> --url devnet
ESCROW_SECRET_KEY=
# Where the JSON store lives (default ./.data)
RIVALRY_DATA_DIR=
